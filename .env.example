# Copy to .env and fill in. Never commit .env (git-ignored).
# Neon direct connection string (not -pooler); search_path selects the schema.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require&search_path=orders
DATABASE_TEST_URL=

PORT=8080
PAYMENT_PORT=8081
INVENTORY_PORT=8082
INVENTORY_URL=http://localhost:8082
PAYMENT_URL=http://localhost:8081

# simulator | razorpay
GATEWAY_PROVIDER=simulator
GATEWAY_MODE=
GATEWAY_LATENCY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
