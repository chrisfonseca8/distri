[Unit]
Description=SSH Docker socket tunnel to %i
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
ExecStart=/usr/bin/ssh -NT -F /home/ec2-user/.ssh/distri-tunnels.conf -o ExitOnForwardFailure=yes -o StreamLocalBindUnlink=yes -L /home/ec2-user/sockets/%i.sock:/var/run/docker.sock %i
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
