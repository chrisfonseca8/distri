  {
   "type": "timeseries",
   "title": "Checkouts accepted vs completed (per second)",
   "description": "A fast 202 with a growing gap to 'completed' is backlog, not scaling.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(sagas_started_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m]))",
     "legendFormat": "accepted (202)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "sum(rate(saga_completions_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\",status=\"COMPLETED\"}[1m]))",
     "legendFormat": "completed",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "sum(rate(saga_completions_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\",status=\"COMPENSATED\"}[1m]))",
     "legendFormat": "compensated",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
