{
 "uid": "02-service-red",
 "title": "2. Per-service RED metrics",
 "description": "Rate, errors and duration for every service, by route.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "tags": [
  "distri"
 ],
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "environment",
    "label": "Environment",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up, environment)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "test_run_id",
    "label": "Test run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{environment=~\"$environment\"}, test_run_id)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{environment=~\"$environment\",test_run_id=~\"$test_run_id\"}, service)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Alerts",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\"}",
    "titleFormat": "{{alertname}}",
    "step": "30s"
   }
  ]
 },
 "links": [
  {
   "title": "Dashboards",
   "type": "dashboards",
   "tags": [
    "distri"
   ],
   "asDropdown": true
  }
 ],
 "panels": [
  {
   "type": "timeseries",
   "title": "Request rate by route",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service, route, method) (rate(http_requests_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m]))",
     "legendFormat": "{{service}} {{method}} {{route}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Responses by class",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service, code_class) (rate(http_requests_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m]))",
     "legendFormat": "{{service}} {{code_class}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 2,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Error ratio (5xx) by route",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service, route) (rate(http_requests_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\",code_class=\"5xx\"}[1m])) / clamp_min(sum by (service, route) (rate(http_requests_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m])), 0.001)",
     "legendFormat": "{{service}} {{route}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Duration p50 / p95 / p99",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (service, le) (rate(http_request_duration_seconds_bucket{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m])))",
     "legendFormat": "{{service}} p50",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m])))",
     "legendFormat": "{{service}} p95",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_request_duration_seconds_bucket{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m])))",
     "legendFormat": "{{service}} p99",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
