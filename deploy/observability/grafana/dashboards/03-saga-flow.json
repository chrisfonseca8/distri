     "expr": "sum(saga_completions_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\",status=\"COMPLETED\"}) / clamp_min(sum(sagas_started_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}), 1)",
