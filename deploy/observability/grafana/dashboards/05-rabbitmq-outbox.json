{
 "uid": "05-rabbitmq-outbox",
 "title": "5. RabbitMQ and outbox health",
 "description": "Message flow between services, retries, dead letters and the outbox relay.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "tags": [
  "distri"
 ],
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "environment",
    "label": "Environment",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up, environment)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "test_run_id",
    "label": "Test run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{environment=~\"$environment\"}, test_run_id)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{environment=~\"$environment\",test_run_id=~\"$test_run_id\"}, service)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Alerts",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\"}",
    "titleFormat": "{{alertname}}",
    "step": "30s"
   }
  ]
 },
 "links": [
  {
   "title": "Dashboards",
   "type": "dashboards",
   "tags": [
    "distri"
   ],
   "asDropdown": true
  }
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Outbox pending",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(outbox_pending_rows{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"})",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
