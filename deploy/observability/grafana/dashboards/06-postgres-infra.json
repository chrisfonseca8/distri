   "id": 2,
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Pool waits (count/s) and wait time (s/s)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rate(go_sql_wait_count_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m])",
     "legendFormat": "waits {{service}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "rate(go_sql_wait_duration_seconds_total{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}[1m])",
     "legendFormat": "wait seconds {{service}}",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
