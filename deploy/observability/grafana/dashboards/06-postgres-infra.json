{
 "uid": "06-postgres-infra",
 "title": "6. Neon/PostgreSQL and infrastructure saturation",
 "description": "Connection pools, query cost, and host/container resources.",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "tags": [
  "distri"
 ],
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "environment",
    "label": "Environment",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up, environment)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "test_run_id",
    "label": "Test run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{environment=~\"$environment\"}, test_run_id)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{environment=~\"$environment\",test_run_id=~\"$test_run_id\"}, service)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Alerts",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\"}",
    "titleFormat": "{{alertname}}",
    "step": "30s"
   }
  ]
 },
 "links": [
  {
   "title": "Dashboards",
   "type": "dashboards",
   "tags": [
    "distri"
   ],
   "asDropdown": true
  }
 ],
 "panels": [
  {
   "type": "timeseries",
   "title": "Pool: open / in use / idle",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "go_sql_open_connections{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}",
     "legendFormat": "open {{service}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "go_sql_in_use_connections{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}",
     "legendFormat": "in use {{service}}",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "go_sql_idle_connections{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}",
     "legendFormat": "idle {{service}}",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 1,
