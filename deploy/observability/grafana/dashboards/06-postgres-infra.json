   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "go_sql_in_use_connections{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"} / go_sql_max_open_connections{environment=~\"$environment\",service=~\"$service\",test_run_id=~\"$test_run_id\"}",
     "legendFormat": "{{service}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
