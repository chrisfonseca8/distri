<mxfile host="app.diagrams.net"><diagram name="Inventory service" id="inventory-service"><mxGraphModel adaptiveColors="auto" pageWidth="3000" pageHeight="2400" dx="1200" dy="800"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="Inventory service :8081" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry" /></mxCell>
<mxCell id="sub" value="owns stock and reservations. Called over HTTP by the orchestrator" style="text;html=1;fontSize=14;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="28" as="geometry" /></mxCell>
<mxCell id="l1" value="Reserve stock (ONE transaction, re-run up to 3 times on deadlock)" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1380" height="200" as="geometry" /></mxCell>
<mxCell id="a1" value="&lt;b&gt;1. Validate&lt;/b&gt;&lt;br&gt;&lt;small&gt;1-20 lines, qty 1-100&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="20" y="70" width="230" height="100" as="geometry" /></mxCell>
<mxCell id="a2" value="&lt;b&gt;2. Claim reservation&lt;/b&gt;&lt;br&gt;&lt;small&gt;by order_id, replay safe&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="290" y="70" width="230" height="100" as="geometry" /></mxCell>
<mxCell id="a3" value="&lt;b&gt;3. Load prices&lt;/b&gt;&lt;br&gt;&lt;small&gt;from products table&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="560" y="70" width="230" height="100" as="geometry" /></mxCell>
<mxCell id="a4" value="&lt;b&gt;4. Lock + reserve&lt;/b&gt;&lt;br&gt;&lt;small&gt;sorted order, only if stock&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="l1"><mxGeometry x="830" y="70" width="230" height="100" as="geometry" /></mxCell>
<mxCell id="a5" value="&lt;b&gt;5. Save&lt;/b&gt;&lt;br&gt;&lt;small&gt;items, RESERVED, total&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l1"><mxGeometry x="1100" y="70" width="230" height="100" as="geometry" /></mxCell>
<mxCell id="a1_a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a2_a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a3_a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a4_a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l2" value="Confirm or release (one transaction)" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1380" height="200" as="geometry" /></mxCell>
<mxCell id="b1" value="&lt;b&gt;1. Guarded status change&lt;/b&gt;&lt;br&gt;&lt;small&gt;RESERVED to CONFIRMED / RELEASED&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l2"><mxGeometry x="20" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b2" value="&lt;b&gt;2. Read lines&lt;/b&gt;&lt;br&gt;&lt;small&gt;in product order&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l2"><mxGeometry x="460" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b3" value="&lt;b&gt;3. Move stock&lt;/b&gt;&lt;br&gt;&lt;small&gt;release: reserved -= qty. confirm: also on_hand -= qty. Release of a CONFIRMED reservation: on_hand += qty (restock)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l2"><mxGeometry x="900" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b1_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l2" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b2_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l2" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="schema" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;SCHEMA: inventory&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;products&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;CHECK price above 0&lt;br&gt;&lt;br&gt;&lt;b&gt;inventories&lt;/b&gt;&lt;br&gt;PK product_id, FK to products&lt;br&gt;CHECK on_hand, reserved, allocated, reserved+allocated not above on_hand&lt;br&gt;&lt;br&gt;&lt;b&gt;reservations&lt;/b&gt;&lt;br&gt;PK id, UNIQUE order_id&lt;br&gt;INDEX (status, created_at)&lt;br&gt;&lt;br&gt;&lt;b&gt;reservation_items&lt;/b&gt;&lt;br&gt;PK (reservation_id, product_id)&lt;br&gt;FK to reservations, products&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox / processed_messages&lt;/b&gt;&lt;br&gt;PK id, UNIQUE message_id, partial INDEX on unpublished / PK message_id" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="100" width="500" height="520" as="geometry" /></mxCell>
<mxCell id="edge" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;STILL OPEN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-8&lt;/b&gt; message bookkeeping is purged after 14 days; reservations and stock are business records and are never purged here&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;Confirm after a release&lt;/b&gt; is still refused (state conflict); the saga's own ordering prevents it" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="720" height="440" as="geometry" /></mxCell>
<mxCell id="imp" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;DONE IN THE FIX PASS (2026-10-25)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-1 / EDGE-2 (IMP-14)&lt;/b&gt; releasing a CONFIRMED reservation is allowed for the unwind of a paid and refunded checkout: the units are restocked once, and a repeat does nothing&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-9 / EDGE-10 (IMP-7)&lt;/b&gt; the orchestrator closes the orphan attempt before this service releases the stock; a live saga's reservation is never released&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;BUG-2 (IMP-8)&lt;/b&gt; the orchestrator checks the 1-20 lines and qty 1-100 limits first and shows clean messages; inventory still enforces them as the last line&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-8 (IMP-10)&lt;/b&gt; purge loop for outbox and processed messages" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="640" width="720" height="440" as="geometry" /></mxCell>
</root></mxGraphModel></diagram></mxfile>