<mxfile host="app.diagrams.net"><diagram name="Orchestrator service" id="orchestrator-service"><mxGraphModel adaptiveColors="auto" pageWidth="3000" pageHeight="2400" dx="1200" dy="800"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="Orchestrator :8083" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry" /></mxCell>
<mxCell id="sub" value="the only entry for clients. Owns the checkout saga" style="text;html=1;fontSize=14;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="28" as="geometry" /></mxCell>
<mxCell id="l1" value="1. Intake: POST /v1/checkouts" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1700" height="200" as="geometry" /></mxCell>
<mxCell id="a1" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;small&gt;8 KB cap, strict JSON&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="20" y="70" width="250" height="100" as="geometry" /></mxCell>
<mxCell id="a2" value="&lt;b&gt;Validate + hash&lt;/b&gt;&lt;br&gt;&lt;small&gt;sort, SHA-256&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="310" y="70" width="250" height="100" as="geometry" /></mxCell>
<mxCell id="a3" value="&lt;b&gt;Claim key&lt;/b&gt;&lt;br&gt;&lt;small&gt;new order_id&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="600" y="70" width="250" height="100" as="geometry" /></mxCell>
<mxCell id="a4" value="&lt;b&gt;Reserve stock&lt;/b&gt;&lt;br&gt;&lt;small&gt;HTTP to Inventory&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="l1"><mxGeometry x="890" y="70" width="250" height="100" as="geometry" /></mxCell>
<mxCell id="a5" value="&lt;b&gt;Create saga&lt;/b&gt;&lt;br&gt;&lt;small&gt;ONE transaction&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="l1"><mxGeometry x="1180" y="70" width="250" height="100" as="geometry" /></mxCell>
<mxCell id="a6" value="&lt;b&gt;202 Accepted&lt;/b&gt;&lt;br&gt;&lt;small&gt;order_id, RUNNING&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l1"><mxGeometry x="1470" y="70" width="250" height="100" as="geometry" /></mxCell>
<mxCell id="a1_a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a2_a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a3_a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a4_a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a5_a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l2" value="2. Order creation round trip" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1700" height="200" as="geometry" /></mxCell>
<mxCell id="b1" value="&lt;b&gt;Outbox relay&lt;/b&gt;&lt;br&gt;&lt;small&gt;claim, publish, confirm&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l2"><mxGeometry x="20" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b2" value="&lt;b&gt;Order service&lt;/b&gt;&lt;br&gt;&lt;small&gt;creates the order&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="l2"><mxGeometry x="460" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b3" value="&lt;b&gt;Reply handler&lt;/b&gt;&lt;br&gt;&lt;small&gt;lock saga, next step&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l2"><mxGeometry x="900" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b4" value="&lt;b&gt;TAKE_PAYMENT&lt;/b&gt;&lt;br&gt;&lt;small&gt;payment.initiate queued&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l2"><mxGeometry x="1340" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b1_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l2" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b2_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l2" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b3_b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l2" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l3" value="3. Saga sweeper (every 5 s)" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1700" height="200" as="geometry" /></mxCell>
<mxCell id="c1" value="&lt;b&gt;Resend&lt;/b&gt;&lt;br&gt;&lt;small&gt;overdue 30 s, max 5 tries&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="20" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="c2" value="&lt;b&gt;Give up&lt;/b&gt;&lt;br&gt;&lt;small&gt;CREATE_ORDER: compensate (cancel order, release stock). Later steps: STUCK for a person&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="460" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="c3" value="&lt;b&gt;Deadline 15 min&lt;/b&gt;&lt;br&gt;&lt;small&gt;before payment: compensate. After: STUCK, a late reply revives it&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="900" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="c4" value="&lt;b&gt;Orphan reservations&lt;/b&gt;&lt;br&gt;&lt;small&gt;claim the orphan attempt first, then release (after 10 min)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="1340" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="c1_c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l3" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="c2_c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l3" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="c3_c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l3" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="schema" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;SCHEMA: orchestrator&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;checkout_attempts&lt;/b&gt;&lt;br&gt;PK idempotency_key&lt;br&gt;&lt;br&gt;&lt;b&gt;sagas&lt;/b&gt;&lt;br&gt;PK id (= order_id)&lt;br&gt;CHECK status, version above 0&lt;br&gt;&lt;br&gt;&lt;b&gt;saga_steps&lt;/b&gt;&lt;br&gt;PK id, UNIQUE (saga_id, step)&lt;br&gt;FK saga_id to sagas&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox&lt;/b&gt;&lt;br&gt;PK id, UNIQUE message_id&lt;br&gt;INDEX (next_attempt_at, created_at) where unpublished&lt;br&gt;&lt;br&gt;&lt;b&gt;processed_messages&lt;/b&gt;&lt;br&gt;PK message_id" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1800" y="100" width="480" height="720" as="geometry" /></mxCell>
<mxCell id="edge" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;STILL OPEN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;Cost of the bounded wait:&lt;/b&gt; a checkout whose replies were only lost, while everything actually succeeded, is refunded and cancelled after the wait&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-15&lt;/b&gt; payment.initiate is resent while the customer pays (harmless); the payment service decides at about 10 min, before the saga gives up at about 12.5 min&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;A stuck undo step&lt;/b&gt; (cancel or release that keeps failing) waits for a person: &lt;b&gt;admin stuck&lt;/b&gt; lists it, &lt;b&gt;admin revive&lt;/b&gt; sends it again. No money is involved&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;IMP-9&lt;/b&gt; a poison outbox row is logged at ERROR after 20 failures, but there is still no metric or paging&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;FEAT-2 to FEAT-5&lt;/b&gt; refund of a completed order on request, retry payment, cancel a checkout, other currencies: need design" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="830" height="560" as="geometry" /></mxCell>
<mxCell id="imp" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;DONE IN THE FIX PASS (2026-10-25)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-1 / EDGE-2&lt;/b&gt; no infinite wait: stuck on MARK_ORDER_PAID or CONFIRM_STOCK for SAGA_STUCK_REFUND_AFTER (10 min) moves the saga to REFUND_PAYMENT, then CANCEL_PAID_ORDER, then RELEASE_STOCK. A late reply for the old step is ignored. Verified on the stack&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-11 (IMP-4, IMP-5)&lt;/b&gt; before payment, exhausted attempts or the deadline compensate: cancel the order, then release the stock&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-9 / EDGE-10 (IMP-7)&lt;/b&gt; the sweeper claims the orphan attempt with one guarded UPDATE, closes it with a clear 409, then releases&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;BUG-1 / BUG-2 (IMP-8)&lt;/b&gt; key capped at 255 characters; limits and clean messages checked here first&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-8 (IMP-10)&lt;/b&gt; purge loop for outbox, processed messages, finished sagas and completed attempts (30 days)&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;FEAT-1&lt;/b&gt; admin tool: stuck and revive" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="910" y="1340" width="830" height="560" as="geometry" /></mxCell>
<mxCell id="l4" parent="1" vertex="1" value="4. Payment reply and completion (each step is one command, one reply)" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;"><mxGeometry x="40" y="880" width="1700" height="420" as="geometry" /></mxCell><mxCell id="p00" parent="l4" vertex="1" value="&lt;b&gt;Payment replied: Succeeded&lt;/b&gt;&lt;br&gt;&lt;small&gt;saga moves to MARK_ORDER_PAID&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="20" y="60" width="380" height="100" as="geometry" /></mxCell><mxCell id="p01" parent="l4" vertex="1" value="&lt;b&gt;Order service&lt;/b&gt;&lt;br&gt;&lt;small&gt;order.mark-paid: PENDING_PAYMENT to PAID&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;"><mxGeometry x="460" y="60" width="380" height="100" as="geometry" /></mxCell><mxCell id="p02" parent="l4" vertex="1" value="&lt;b&gt;Inventory&lt;/b&gt;&lt;br&gt;&lt;small&gt;inventory.confirm: stock consumed&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;"><mxGeometry x="900" y="60" width="380" height="100" as="geometry" /></mxCell><mxCell id="p03" parent="l4" vertex="1" value="&lt;b&gt;Saga COMPLETED&lt;/b&gt;&lt;br&gt;&lt;small&gt;client sees COMPLETED&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="1340" y="60" width="380" height="100" as="geometry" /></mxCell><mxCell id="p00_p01" parent="l4" edge="1" source="p00" target="p01" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p01_p02" parent="l4" edge="1" source="p01" target="p02" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p02_p03" parent="l4" edge="1" source="p02" target="p03" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10" parent="l4" vertex="1" value="&lt;b&gt;Payment replied: Failed&lt;/b&gt;&lt;br&gt;&lt;small&gt;saga moves to MARK_ORDER_CANCELLED&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="20" y="200" width="380" height="100" as="geometry" /></mxCell><mxCell id="p11" parent="l4" vertex="1" value="&lt;b&gt;Order service&lt;/b&gt;&lt;br&gt;&lt;small&gt;order.cancel: to CANCELLED&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;"><mxGeometry x="460" y="200" width="380" height="100" as="geometry" /></mxCell><mxCell id="p12" parent="l4" vertex="1" value="&lt;b&gt;Inventory&lt;/b&gt;&lt;br&gt;&lt;small&gt;inventory.release: stock returned&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;"><mxGeometry x="900" y="200" width="380" height="100" as="geometry" /></mxCell><mxCell id="p13" parent="l4" vertex="1" value="&lt;b&gt;Saga COMPENSATED&lt;/b&gt;&lt;br&gt;&lt;small&gt;client sees COMPENSATED&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="1340" y="200" width="380" height="100" as="geometry" /></mxCell><mxCell id="p10_p11" parent="l4" edge="1" source="p10" target="p11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11_p12" parent="l4" edge="1" source="p11" target="p12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12_p13" parent="l4" edge="1" source="p12" target="p13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pstuck" parent="l4" vertex="1" value="&lt;b&gt;A step fails for good: STUCK&lt;/b&gt;&lt;br&gt;&lt;small&gt;a person can fix it (admin revive); after 10 min with money taken the saga refunds and unwinds by itself&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="420" y="330" width="860" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>