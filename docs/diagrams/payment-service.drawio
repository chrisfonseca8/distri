<mxfile host="app.diagrams.net"><diagram name="Payment service" id="payment-service"><mxGraphModel adaptiveColors="auto" pageWidth="3000" pageHeight="2400" dx="1200" dy="800"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="Payment service :8082" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry" /></mxCell>
<mxCell id="sub" value="creates the gateway order, finds out whether the customer paid, decides on time, tells the orchestrator" style="text;html=1;fontSize=14;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="28" as="geometry" /></mxCell>
<mxCell id="l1" value="1. Intake: payment.initiate (ONE transaction)" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1700" height="200" as="geometry" /></mxCell>
<mxCell id="a1" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;small&gt;order id, amount, currency&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="20" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="a2" value="&lt;b&gt;Record message id&lt;/b&gt;&lt;br&gt;&lt;small&gt;duplicate: stop&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="460" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="a3" value="&lt;b&gt;Create attempt&lt;/b&gt;&lt;br&gt;&lt;small&gt;CREATED, unique per order&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="900" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="a4" value="&lt;b&gt;Queue job&lt;/b&gt;&lt;br&gt;&lt;small&gt;process_payment&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l1"><mxGeometry x="1340" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="a1_a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a2_a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a3_a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l2" value="2. Job worker: call the gateway (no database transaction open during the call)" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1700" height="200" as="geometry" /></mxCell>
<mxCell id="b1" value="&lt;b&gt;Claim job&lt;/b&gt;&lt;br&gt;&lt;small&gt;SKIP LOCKED + lease&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l2"><mxGeometry x="20" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b2" value="&lt;b&gt;Mark PENDING&lt;/b&gt;&lt;br&gt;&lt;small&gt;guarded, one worker only&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l2"><mxGeometry x="460" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b3" value="&lt;b&gt;Call gateway&lt;/b&gt;&lt;br&gt;&lt;small&gt;POST /v1/orders, 3 s. Never sent: retried quickly&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="l2"><mxGeometry x="900" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b4" value="&lt;b&gt;Save result&lt;/b&gt;&lt;br&gt;&lt;small&gt;AWAITING_PAYMENT, FAILED or UNKNOWN&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l2"><mxGeometry x="1340" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="b1_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l2" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b2_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l2" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="b3_b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l2" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l3" value="3. Evidence: two independent routes, whichever arrives first" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1700" height="200" as="geometry" /></mxCell>
<mxCell id="c1" value="&lt;b&gt;Webhook received&lt;/b&gt;&lt;br&gt;&lt;small&gt;verify signature, store, answer 200&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="20" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="c2" value="&lt;b&gt;Webhook worker&lt;/b&gt;&lt;br&gt;&lt;small&gt;lock attempt, apply, dedupe&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="460" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="c3" value="&lt;b&gt;Reconciler poll&lt;/b&gt;&lt;br&gt;&lt;small&gt;about every 15 s, by receipt&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="900" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="c4" value="&lt;b&gt;Gateway unreachable&lt;/b&gt;&lt;br&gt;&lt;small&gt;asked again; after window + 5 min grace the attempt is FAILED (UNCONFIRMED)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l3"><mxGeometry x="1340" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="c1_c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l3" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="c2_c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l3" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="c3_c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l3" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l4" value="4. Decision and outcome" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1700" height="200" as="geometry" /></mxCell>
<mxCell id="e1" value="&lt;b&gt;Decide on OUR clock&lt;/b&gt;&lt;br&gt;&lt;small&gt;before deadline, late, wrong amount&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l4"><mxGeometry x="20" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="e2" value="&lt;b&gt;Reply to orchestrator&lt;/b&gt;&lt;br&gt;&lt;small&gt;Succeeded, Failed or Ambiguous (outbox)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l4"><mxGeometry x="460" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="e3" value="&lt;b&gt;Refund record&lt;/b&gt;&lt;br&gt;&lt;small&gt;late or extra capture, or the saga asked for the funding payment (payment.refund). Never a blind resend&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="l4"><mxGeometry x="900" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="e4" value="&lt;b&gt;Compensation worker&lt;/b&gt;&lt;br&gt;&lt;small&gt;lookup first, refund, review if unclear&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l4"><mxGeometry x="1340" y="70" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="e1_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l4" source="e1" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l4" source="e2" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="l4" source="e3" target="e4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="schema" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;SCHEMA: payments&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;payment_attempts&lt;/b&gt;&lt;br&gt;PK id, UNIQUE order_id&lt;br&gt;UNIQUE gateway_order_id (when set)&lt;br&gt;CHECK status, amount above 0&lt;br&gt;&lt;br&gt;&lt;b&gt;jobs&lt;/b&gt;&lt;br&gt;PK id, UNIQUE (type, payment_id)&lt;br&gt;INDEX (next_run_at) for queued and running&lt;br&gt;&lt;br&gt;&lt;b&gt;webhook_events&lt;/b&gt;&lt;br&gt;PK id, UNIQUE event_id&lt;br&gt;INDEX claim (PENDING), gateway order, parked&lt;br&gt;&lt;br&gt;&lt;b&gt;compensation_records&lt;/b&gt;&lt;br&gt;PK id, UNIQUE (gateway, gateway_payment_id)&lt;br&gt;INDEX (next_attempt_at), (payment_attempt_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;compensation_events&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;INDEX (record_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox / processed_messages&lt;/b&gt;&lt;br&gt;PK id, UNIQUE message_id, partial INDEX on unpublished / PK message_id" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1800" y="100" width="520" height="980" as="geometry" /></mxCell>
<mxCell id="edge" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;STILL OPEN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-3 / EDGE-4&lt;/b&gt; a service outage or a delayed webhook makes an on-time payment look late, so it is refunded (accepted trade-off)&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-6&lt;/b&gt; a refund whose outcome is unknown, or that holds a provider refund, waits for a person: &lt;b&gt;admin review&lt;/b&gt;, &lt;b&gt;review-retry&lt;/b&gt;. Only definitive rejections are retried automatically&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-7&lt;/b&gt; unmatched events are parked: &lt;b&gt;admin parked&lt;/b&gt; and &lt;b&gt;parked-replay&lt;/b&gt;; purged after 30 days&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;FEAT-2&lt;/b&gt; no refund of a completed order on request (only the saga's own unwind)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="830" height="520" as="geometry" /></mxCell>
<mxCell id="imp" value="&lt;font style='font-size:17px'&gt;&lt;b&gt;DONE IN THE FIX PASS (2026-10-25)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-1 / EDGE-2 (IMP-14)&lt;/b&gt; new command payment.refund: records a refund for the payment that funded a checkout the saga could not complete; the compensation worker refunds it. The funding payment is refunded for no other reason&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-14 (IMP-13)&lt;/b&gt; a request that never left the process is retried quickly; a down gateway fails in about 16 s&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;IMP-6&lt;/b&gt; gateway unreachable past the window plus grace becomes FAILED (UNCONFIRMED); a later capture is refunded&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-6 (IMP-15)&lt;/b&gt; a refund the gateway kept rejecting is retried automatically 3 times, 30 minutes apart, before it is left to a person&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;BUG-3 (IMP-11)&lt;/b&gt; no webhook secret with the razorpay provider refuses to start unless WEBHOOKS_DISABLED=true&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-8 (IMP-10)&lt;/b&gt; purge loop; &lt;b&gt;FEAT-1&lt;/b&gt; admin tool" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="910" y="1140" width="830" height="520" as="geometry" /></mxCell>
</root></mxGraphModel></diagram></mxfile>