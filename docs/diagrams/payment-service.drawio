<mxfile>
  <diagram name="Payment service" id="payment-service">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="0" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="2400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=24;fontStyle=1;align=left;" value="Payment service :8082" vertex="1">
          <mxGeometry height="40" width="1500" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=14;align=left;fontColor=#666666;" value="creates the gateway order, finds out whether the customer paid, decides on time, tells the orchestrator" vertex="1">
          <mxGeometry height="28" width="1500" x="40" y="52" as="geometry" />
        </mxCell>
        <mxCell id="l1" parent="1" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" value="1. Intake: payment.initiate (ONE transaction)" vertex="1">
          <mxGeometry height="200" width="1700" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="l1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;small&gt;order id, amount, currency&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="20" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="l1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Record message id&lt;/b&gt;&lt;br&gt;&lt;small&gt;duplicate: stop&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="460" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="l1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Create attempt&lt;/b&gt;&lt;br&gt;&lt;small&gt;CREATED, unique per order&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="900" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="l1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Queue job&lt;/b&gt;&lt;br&gt;&lt;small&gt;process_payment&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="1340" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a1_a2" edge="1" parent="l1" source="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="a2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2_a3" edge="1" parent="l1" source="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="a3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3_a4" edge="1" parent="l1" source="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="a4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2" parent="1" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" value="2. Job worker: call the gateway (no database transaction open during the call)" vertex="1">
          <mxGeometry height="200" width="1700" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="l2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Claim job&lt;/b&gt;&lt;br&gt;&lt;small&gt;SKIP LOCKED + lease&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="20" y="70" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="l2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Mark PENDING&lt;/b&gt;&lt;br&gt;&lt;small&gt;guarded, one worker only&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="460" y="70" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="l2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" value="&lt;b&gt;Call gateway&lt;/b&gt;&lt;br&gt;&lt;small&gt;POST /v1/orders, 3 s&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="900" y="70" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="l2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Save result&lt;/b&gt;&lt;br&gt;&lt;small&gt;AWAITING_PAYMENT, FAILED or UNKNOWN&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="1340" y="70" as="geometry" />
        </mxCell>
        <mxCell id="b1_b2" edge="1" parent="l2" source="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="b2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2_b3" edge="1" parent="l2" source="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="b3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3_b4" edge="1" parent="l2" source="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="b4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3" parent="1" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" value="3. Evidence: two independent routes, whichever arrives first" vertex="1">
          <mxGeometry height="200" width="1700" x="40" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="l3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Webhook received&lt;/b&gt;&lt;br&gt;&lt;small&gt;verify signature, store, answer 200&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="20" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="l3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Webhook worker&lt;/b&gt;&lt;br&gt;&lt;small&gt;lock attempt, apply, dedupe&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="460" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="l3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Reconciler poll&lt;/b&gt;&lt;br&gt;&lt;small&gt;about every 15 s, by receipt&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="900" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="l3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" value="&lt;b&gt;Gateway unreachable&lt;/b&gt;&lt;br&gt;&lt;small&gt;stays UNKNOWN, asked again (EDGE-14)&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="1340" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c1_c2" edge="1" parent="l3" source="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="c2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2_c3" edge="1" parent="l3" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="c3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3_c4" edge="1" parent="l3" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="c4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l4" parent="1" style="swimlane;startSize=36;html=1;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" value="4. Decision and outcome" vertex="1">
          <mxGeometry height="200" width="1700" x="40" y="880" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="l4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Decide on OUR clock&lt;/b&gt;&lt;br&gt;&lt;small&gt;before deadline, late, wrong amount&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="20" y="70" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="l4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Reply to orchestrator&lt;/b&gt;&lt;br&gt;&lt;small&gt;Succeeded, Failed or Ambiguous (outbox)&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="460" y="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="l4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;Refund record&lt;/b&gt;&lt;br&gt;&lt;small&gt;late or extra capture, never blind resend&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="900" y="70" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="l4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Compensation worker&lt;/b&gt;&lt;br&gt;&lt;small&gt;lookup first, refund, review if unclear&lt;/small&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="1340" y="70" as="geometry" />
        </mxCell>
        <mxCell id="e1_e2" edge="1" parent="l4" source="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="e2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2_e3" edge="1" parent="l4" source="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="e3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_e4" edge="1" parent="l4" source="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" target="e4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="schema" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;font style=&#39;font-size:17px&#39;&gt;&lt;b&gt;SCHEMA: payments&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;payment_attempts&lt;/b&gt;&lt;br&gt;PK id, UNIQUE order_id&lt;br&gt;UNIQUE gateway_order_id (when set)&lt;br&gt;CHECK status, amount above 0&lt;br&gt;&lt;br&gt;&lt;b&gt;jobs&lt;/b&gt;&lt;br&gt;PK id, UNIQUE (type, payment_id)&lt;br&gt;INDEX (next_run_at) for queued and running&lt;br&gt;&lt;br&gt;&lt;b&gt;webhook_events&lt;/b&gt;&lt;br&gt;PK id, UNIQUE event_id&lt;br&gt;INDEX claim (PENDING), gateway order, parked&lt;br&gt;&lt;br&gt;&lt;b&gt;compensation_records&lt;/b&gt;&lt;br&gt;PK id, UNIQUE (gateway, gateway_payment_id)&lt;br&gt;INDEX (next_attempt_at), (payment_attempt_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;compensation_events&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;INDEX (record_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox / processed_messages&lt;/b&gt;&lt;br&gt;PK id, UNIQUE message_id, partial INDEX on unpublished / PK message_id" vertex="1">
          <mxGeometry height="980" width="520" x="1800" y="100" as="geometry" />
        </mxCell>
        <mxCell id="edge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="&lt;font style=&#39;font-size:17px&#39;&gt;&lt;b&gt;EDGE CASES NOT HANDLED YET&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-14&lt;/b&gt; gateway fully down is treated like a timeout: the customer only hears of the failure after the 5 min window&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-15&lt;/b&gt; the saga resends payment.initiate while the customer is paying; if still unresolved at about 12.5 min the saga goes STUCK&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-3 / EDGE-4&lt;/b&gt; a service outage or a delayed webhook makes an on-time payment look late, so it is refunded&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-6&lt;/b&gt; refund records in REVIEW wait for a person&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;EDGE-7&lt;/b&gt; unmatched webhook events are parked forever&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;BUG-3&lt;/b&gt; webhooks switch off silently if the secret is unset" vertex="1">
          <mxGeometry height="520" width="830" x="40" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="imp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="&lt;font style=&#39;font-size:17px&#39;&gt;&lt;b&gt;IMPROVEMENTS TO MAKE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;IMP-6&lt;/b&gt; payment-service decides: after the window plus a grace (about 10 min) with no evidence, mark FAILED; a later capture is refunded&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;IMP-13&lt;/b&gt; tell &#39;never sent&#39; from &#39;sent, unknown&#39;: retry the first quickly, keep the second UNKNOWN&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;IMP-11&lt;/b&gt; fail closed when the webhook secret is unset&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;FEAT-1&lt;/b&gt; admin tool for REVIEW refunds and parked events&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;IMP-10&lt;/b&gt; purge old webhook events, outbox and processed rows" vertex="1">
          <mxGeometry height="520" width="830" x="910" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="5A9iZXgI0yRguE_bmTvl-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Text" vertex="1">
          <mxGeometry height="30" width="60" x="840" y="-110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
